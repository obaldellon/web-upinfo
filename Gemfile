source 'https://rubygems.org'

gem 'jekyll', '= 4.0.1'
gem "liquid", "~> 4.0.4"


group :jekyll_plugins do
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem "jekyll-asciidoc"
  gem "jekyll-toc"
end



# jekyll-scholar 6.x (bibtex-ruby 5) ne fonctionne pas avec Ruby >= 3
gem "jekyll-scholar", RUBY_VERSION >= "3" ? "~> 7.1" : "= 6.8.1"

gem "webrick", "~> 1.7"


gem 'logger', '= 1.5'
