{% assign id = include.id %}
{% assign cours = site.ue | where:"cours-id", id | first %}
{% assign authors = cours.author | split: ", " %}
{% assign names = "<b>" %}
{% assign responsable = "Responsable" %}

{% assign dernier-auteur = "" %}
{% assign conjonction  = "" %}

{% for author in authors %}
        {% if site.data.authors[author].name %}
            {% if dernier-auteur == "" %}
                {% assign dernier-auteur = site.data.authors[author].name %}
                {% assign conjonction  = "" %}
            {% else %}
                {% assign responsable = "Responsables" %}
                {% assign names = names | append:conjonction | append:dernier-auteur %}
                {% assign dernier-auteur = site.data.authors[author].name %}
                {% assign conjonction  = ", " %}
            {% endif %}
        {% endif %}
    {% endfor %}

{% if conjonction == ", " %}
 {% assign conjonction  = " et " %}
{% endif %}
{% assign names = names | append:conjonction | append:dernier-auteur | append:"</b>"%}

{% capture lien-fiche %}{{ site.baseurl }}{{ cours.url }}{% endcapture %}
{% assign debut-syllabus = cours.syllabus | slice: 0, 4 %}
{% if debut-syllabus == "http" %}
  {% assign lien-titre = cours.syllabus %}
{% elsif cours.syllabus %}
  {% capture lien-titre %}https://syllabus.univ-cotedazur.fr/fr/course/router-light/{{ cours.syllabus }}{% endcapture %}
{% else %}
  {% assign lien-titre = lien-fiche %}
{% endif %}

{% if cours.subtitle %}
#### <a href="{{ lien-titre }}">{{ cours.title }} : {{ cours.subtitle }}</a> ####
{% else %}
#### <a href="{{ lien-titre }}"> {{ cours.title }}</a> ####
{% endif %}

{{ responsable }} : {{ names }}
<br/>
{{cours.teaser }}{% if cours.en-savoir-plus or cours.syllabus == nil %} <a href="{{ lien-fiche }}"> En savoir plus</a>{% endif %}


